spring.application.name=banking-system
server.error.include-stacktrace=never

# Supabase PostgreSQL Database Configuration
spring.datasource.url=${SUPABASE_DB_URL}
spring.datasource.username=${SUPABASE_DB_USERNAME}
spring.datasource.password=${SUPABASE_DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate settings
# Required for production: DO NOT use update in prod, use validate with Prisma/Flyway handling migrations
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Application-Level Security Key
# Must be a Base64-encoded 32-byte (256-bit) string for AES-256-GCM encryption
app.security.db-encryption-key=${AES_SECRET_KEY}
